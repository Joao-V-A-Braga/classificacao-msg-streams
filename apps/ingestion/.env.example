# Laya local (CPU): classifica as mensagens com as tags de cada monitoramento.
LAYA_MODEL=convaiinnovations/laya
LAYA_CLASSIFIER_HOST=127.0.0.1
LAYA_CLASSIFIER_PORT=8100

# Backend Symfony (/ingestion/*) — mesma chave de apps/backend/.env.local
# (MESSAGE_INGESTION_API_KEY). O start.ps1 preenche na primeira execucao.
BACKEND_BASE_URL=http://localhost:8000
BACKEND_INGESTION_API_KEY=

# A cada quantos segundos o runner pergunta ao backend quais monitoramentos estao rodando.
RUNNER_INTERVAL_SECONDS=3

# Traducao para o ingles antes do Laya (o Laya e treinado em ingles: classifica melhor). Usa o
# modelo de texto abaixo (OpenAI-compatible; Ollama local por padrao). Sem ele no ar, classifica o
# texto original. TRANSLATE_FOR_LAYA=false desliga.
TRANSLATE_FOR_LAYA=true
TEXT_MODEL_BASE_URL=http://localhost:11434/v1
TEXT_MODEL=llama3.2:3b
TEXT_MODEL_TIMEOUT_SECONDS=20
# TEXT_MODEL_API_KEY= # so para um endpoint que nao seja o Ollama local
